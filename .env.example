# Copy this file to .env and fill in your values. .env is git-ignored.

# LLM endpoint used by the IRA evaluator. Any OpenAI-compatible API works.
IRA_API_KEY=your-api-key
IRA_BASE_URL=https://your-openai-compatible-endpoint/v1

# Desktop environment server. Values set in configs/*.yaml take precedence.
OSWORLD_BASE_URL=http://127.0.0.1:50003
OSWORLD_TOKEN=reward
