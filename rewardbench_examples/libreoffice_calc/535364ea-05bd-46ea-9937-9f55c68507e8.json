      "step_num": 63,
      "action_timestamp": "20260303@193129",
      "action": "import pyautogui; import time; pyautogui.FAILSAFE = False; pyautogui.write('Sub CreatePivotTables()\\n    Dim oDoc As Object\\n    Dim oSheet1 As Object\\n    Dim oSheet2 As Object\\n    Dim oCell As Object\\n    Dim i As Long, lastRow As Long\\n\\n    oDoc = ThisComponent\\n    oSheet1 = oDoc.Sheets.getByName(\"Sheet1\")\\n\\n    \\' Delete Sheet2 if exists and recreate\\n    If oDoc.Sheets.hasByName(\"Sheet2\") Then\\n        oDoc.Sheets.removeByName(\"Sheet2\")\\n    End If\\n    oDoc.Sheets.insertNewByName(\"Sheet2\", 1)\\n    oSheet2 = oDoc.Sheets.getByName(\"Sheet2\")\\n\\n    \\' Find last row in Sheet1\\n    lastRow = 1\\n    Do While oSheet1.getCellByPosition(0, lastRow).getString() <> \"\"\\n        lastRow = lastRow + 1\\n    Loop\\n    lastRow = lastRow - 1 \\' last data row index (0-based)\\n\\n    \\' Columns in Sheet1 (0-based): E=4 Sales Channel, F=5 Product, G=6 Revenue\\n\\n    \\' --- Pivot Table 1: Total Revenue by Product ---\\n    oSheet2.getCellByPosition(0,0).setString(\"Product\")\\n    oSheet2.getCellByPosition(1,0).setString(\"Total Revenue ($)\")\\n\\n    \\' Collect unique products\\n    Dim products() As String\\n    Dim pCount As Integer\\n    pCount = 0\\n    ReDim products(0)\\n\\n    For i = 1 To lastRow\\n        Dim prod As String\\n        prod = oSheet1.getCellByPosition(5, i).getString()\\n        Dim found As Boolean\\n        found = False\\n        Dim j As Integer\\n        For j = 0 To pCount - 1\\n            If products(j) = prod Then\\n                found = True\\n                Exit For\\n            End If\\n        Next j\\n        If Not found And prod <> \"\" Then\\n            ReDim Preserve products(pCount)\\n            products(pCount) = prod\\n            pCount = pCount + 1\\n        End If\\n    Next i\\n\\n    \\' Write products and sum revenues\\n    For j = 0 To pCount - 1\\n        oSheet2.getCellByPosition(0, j+1).setString(products(j))\\n        Dim total As Double\\n        total = 0\\n        For i = 1 To lastRow\\n            If oSheet1.getCellByPosition(5, i).getString() = products(j) Then\\n                total = total + oSheet1.getCellByPosition(6, i).getValue()\\n            End If\\n        Next i\\n        oSheet2.getCellByPosition(1, j+1).setValue(total)\\n    Next j\\n\\n    \\' --- Pivot Table 2: Total Revenue by Sales Channel ---\\n    Dim startRow2 As Integer\\n    startRow2 = pCount + 3 \\' leave a blank row gap\\n\\n    oSheet2.getCellByPosition(0, startRow2).setString(\"Sales Channel\")\\n    oSheet2.getCellByPosition(1, startRow2).setString(\"Total Revenue ($)\")\\n\\n    \\' Collect unique sales channels\\n    Dim channels() As String\\n    Dim cCount As Integer\\n    cCount = 0\\n    ReDim channels(0)\\n\\n    For i = 1 To lastRow\\n        Dim ch As String\\n        ch = oSheet1.getCellByPosition(4, i).getString()\\n        Dim foundC As Boolean\\n        foundC = False\\n        For j = 0 To cCount - 1\\n            If channels(j) = ch Then\\n                foundC = True\\n                Exit For\\n            End If\\n        Next j\\n        If Not foundC And ch <> \"\" Then\\n            ReDim Preserve channels(cCount)\\n            channels(cCount) = ch\\n            cCount = cCount + 1\\n        End If\\n    Next i\\n\\n    \\' Write channels and sum revenues\\n    For j = 0 To cCount - 1\\n        oSheet2.getCellByPosition(0, startRow2 + j + 1).setString(channels(j))\\n        Dim totalC As Double\\n        totalC = 0\\n        For i = 1 To lastRow\\n            If oSheet1.getCellByPosition(4, i).getString() = channels(j) Then\\n                totalC = totalC + oSheet1.getCellByPosition(6, i).getValue()\\n            End If\\n        Next i\\n        oSheet2.getCellByPosition(1, startRow2 + j + 1).setValue(totalC)\\n    Next j\\n\\n    \\' Save the document\\n    oDoc.store()\\n\\n    MsgBox \"Done! Pivot tables created on Sheet2.\"\\nEnd Sub', interval=0.05); time.sleep(0.5)",
